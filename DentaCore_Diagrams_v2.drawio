<mxCell id="note_visit" value="Visit decouples clinical record from scheduling: appointmentId is
optional (walk-ins allowed), and a Visit can carry multiple Treatments
(fixes the old 1:1 appointment&lt;-&gt;treatment constraint)." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="1220" y="380" width="280" height="80" as="geometry"/>
    </mxCell>
<mxCell id="note_plan" value="TreatmentPlan groups Treatments performed across multiple Visits/days
toward one case. TreatmentPlanItem is a cost-estimate/proposal line —
deliberately no accept/decline workflow (scope decision)." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="1220" y="500" width="280" height="90" as="geometry"/>
    </mxCell>
<mxCell id="note_stripe" value="Planned: PaymentAttempt (server-side state carrier for Stripe checkout
round-trip) and WebhookEvent (inbox-pattern idempotency guard) —
not yet migrated." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="1220" y="1000" width="280" height="80" as="geometry"/>
    </mxCell>
<mxCell id="note_audit" value="AuditLog references actorId/targetId polymorphically — deliberately no
FK constraint so history survives hard deletes. TargetType now includes
VISIT / TREATMENT_PLAN / TREATMENT_PLAN_ITEM." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="1500" y="620" width="280" height="90" as="geometry"/>
    </mxCell>
