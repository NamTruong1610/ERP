    </mxCell>
<mxCell id="c4" value="Set-Cookie: SESSIONID, REMEMBER
(httpOnly, per COOKIE_OPTIONS)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="40" y="840" width="160" height="50" as="geometry"/>
    </mxCell>
<mxCell id="a7" value="AuditLog: LOGIN_SUCCESS" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="260" y="840" width="380" height="50" as="geometry"/>
    </mxCell>
<mxCell id="c5" value="Any subsequent request
cookie: SESSIONID" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="40" y="930" width="160" height="50" as="geometry"/>
    </mxCell>
<mxCell id="a8" value="requireAuth middleware:
GET session:{sessionId}" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="260" y="930" width="380" height="50" as="geometry"/>
    </mxCell>
<mxCell id="a9" value="hit → req.user = session;
ZREMRANGEBYSCORE zombie cleanup on
user_sessions &amp; user_remember;
EXPIRE session key; ZADD refreshed score" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="260" y="1000" width="380" height="75" as="geometry"/>
    </mxCell>
<mxCell id="r7" value="session:{sessionId} TTL renewed
user_sessions:{userId} score bumped" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="700" y="1000" width="380" height="60" as="geometry"/>
    </mxCell>
<mxCell id="c6" value="re-issues SESSIONID cookie
(rolling expiry)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="40" y="1090" width="160" height="45" as="geometry"/>
    </mxCell>
<mxCell id="a10" value="miss → fall back to cookie REMEMBER
GET token:remember:{rememberTokenId}" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="260" y="1150" width="380" height="55" as="geometry"/>
    </mxCell>
<mxCell id="a11" value="hit → rotate: new sessionId + new
rememberTokenId; write new session +
remember keys; DEL old remember token" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="260" y="1220" width="380" height="70" as="geometry"/>
    </mxCell>
<mxCell id="r8" value="new session:{}, new user_sessions ZADD,
new token:remember:{}, new user_remember ZADD,
DEL old token:remember:{oldId}" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="700" y="1220" width="380" height="75" as="geometry"/>
    </mxCell>
<mxCell id="c7" value="Set-Cookie: new SESSIONID, REMEMBER" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="40" y="1305" width="160" height="45" as="geometry"/>
    </mxCell>
<mxCell id="a12" value="miss on both → 401 Unauthenticated" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="260" y="1305" width="380" height="45" as="geometry"/>
    </mxCell>
<mxCell id="c8" value="POST /auth/logout" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="40" y="1375" width="160" height="45" as="geometry"/>
    </mxCell>
<mxCell id="a13" value="logoutService → invalidateLocalUserSession
(sessionId, rememberTokenId)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="260" y="1375" width="380" height="55" as="geometry"/>
    </mxCell>
<mxCell id="r9" value="DEL session:{sessionId}
ZREM user_sessions:{userId} sessionId
DEL token:remember:{id}
ZREM user_remember:{userId} id" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="700" y="1440" width="380" height="75" as="geometry"/>
    </mxCell>
<mxCell id="c9" value="Password reset / &quot;logout everywhere&quot;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="40" y="1530" width="160" height="45" as="geometry"/>
    </mxCell>
<mxCell id="a14" value="invalidateAllUserSessions(userId)
ZRANGE both registries → delete all keys
