// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// IDENTITY & AUTH
// =============================================================================

model User {
  id                    String          @id @default(cuid())
  email                 String
  password              String?
  status                UserStatus      @default(PENDING_ACTIVATION)
  phones                String[]        @default([])
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?

  name                  UserName?
  addresses             Address[]
  roles                 UserRole[]
  userActivation        UserActivation?
  userMfa               UserMfa?

  appointments          Appointment[]
  visitProviders        VisitProvider[]
  performedTreatments   Treatment[]
  treatmentPlansCreated TreatmentPlan[]
  uploadedFiles         File[]          @relation(name: "uploadedFiles")
  payments              Payment[]       @relation(name: "recordedPayments")
  voidedPayments        Payment[]       @relation(name: "voidedPayments")
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  role       Role
  assignedBy String?
  assignedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model UserMfa {
  id        String   @id @default(cuid())
  userId    String   @unique
  enabled   Boolean  @default(false)
  mfaSecret String?
  mfaUri    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserActivation {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenId   String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserName {
  id     String @id @default(cuid())
  userId String @unique
  fName  String?
  mName  String?
  lName  String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id     String  @id @default(cuid())
  userId String
  street String?
  suburb String?
  post   String?
  city   String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =============================================================================
// CLINICAL — patients, scheduling, visits, treatment plans, treatments
// =============================================================================

model Patient {
  id             String          @id @default(cuid())
  firstName      String
  lastName       String
  dob            DateTime        // date of birth
  gender         String
  phone          String?
  email          String?
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  appointments   Appointment[]
  visits         Visit[]
  treatmentPlans TreatmentPlan[]
  files          File[]
  invoices       Invoice[]
}

model Appointment {
  id        String            @id @default(cuid())
  dentistId String?
  patientId String
  date      DateTime
  status    AppointmentStatus @default(SCHEDULED) // SCHEDULED, COMPLETED, CANCELLED
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?

  dentist   User?             @relation(fields: [dentistId], references: [id])
  patient   Patient           @relation(fields: [patientId], references: [id])
  visit     Visit?            @relation
}

model Visit {
  id             String          @id @default(cuid())
  patientId      String
  appointmentId  String?         @unique // a Visit can exist w/o an appointment (walk-in)
  visitDate      DateTime
  status         VisitStatus     // IN_PROGRESS | COMPLETED | CANCELLED
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  visitProviders VisitProvider[]
  treatments     Treatment[]

  patient        Patient         @relation(fields: [patientId], references: [id])
  appointment    Appointment?    @relation(fields: [appointmentId], references: [id])
}

model VisitProvider {
  id          String            @id @default(cuid())
  visitId     String
  performerId String
  role        VisitProviderRole // PRIMARY | ASSISTING | HYGIENIST | OTHER
  createdAt   DateTime          @default(now())

  visit       Visit             @relation(fields: [visitId], references: [id])
  performer   User              @relation(fields: [performerId], references: [id])

  @@unique([visitId, performerId])
}

model TreatmentPlan {
  id                 String              @id @default(cuid())
  patientId          String
  createdById        String?
  title              String
  status             TreatmentPlanStatus // PROPOSED | ACTIVE | COMPLETED | CANCELLED
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?

  treatments         Treatment[]
  treatmentPlanItems TreatmentPlanItem[]

  patient            Patient             @relation(fields: [patientId], references: [id])
  createdBy          User?               @relation(fields: [createdById], references: [id])
}

model TreatmentPlanItem {
  id              String         @id @default(cuid())
  treatmentPlanId String
  procedure       String
  toothNumber     Int?
  estimatedAmount Float
  status          PlanItemStatus // PROPOSED | COMPLETED | CANCELLED
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  treatment       Treatment?

  treatmentPlan   TreatmentPlan  @relation(fields: [treatmentPlanId], references: [id])
}

model Treatment {
  id                  String             @id @default(cuid())
  visitId             String
  treatmentPlanId     String?
  treatmentPlanItemId String?            @unique
  performedById       String?
  procedure           String             // e.g. filling, extraction, cleaning
  toothNumber         Int?               // 1-32
  notes               String?
  amount              Float
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  invoiceItem         InvoiceItem?

  visit               Visit              @relation(fields: [visitId], references: [id])
  treatmentPlan       TreatmentPlan?     @relation(fields: [treatmentPlanId], references: [id])
  treatmentPlanItem   TreatmentPlanItem? @relation(fields: [treatmentPlanItemId], references: [id])
  performedBy         User?              @relation(fields: [performedById], references: [id])
}

// =============================================================================
// FILES
// =============================================================================

model File {
  id         String     @id @default(cuid())
  patientId  String
  uploadedBy String
  fileName   String     // original name shown in UI
  storageKey String     @unique // R2 object key — never exposed to client
  mimeType   String
  fileType   FileType
  sizeBytes  Int
  status     FileStatus @default(PENDING)
  createdAt  DateTime   @default(now())
  deletedAt  DateTime?

  patient    Patient    @relation(fields: [patientId], references: [id])
  uploader   User       @relation(fields: [uploadedBy], references: [id], name: "uploadedFiles")
}

// =============================================================================
// BILLING — invoices, payments, allocations
// =============================================================================

model Invoice {
  id              String        @id @default(cuid())
  patientId       String
  invoiceNumber   String?       @unique // e.g. INV-2026-0001, human-readable
  status          InvoiceStatus @default(DRAFT)
  subtotal        Float
  discount        Float
  tax             Float         @default(0)
  total           Float
  paidAmount      Float         @default(0)
  abn             String        @default("00000000000")
  notes           String?
  issuedAt        DateTime?
  dueAt           DateTime?
  paidAt          DateTime?
  billedToName    String?       // "ABC Insurance Pty Ltd"
  billedToEmail   String?       // "accounts@insurance.com"
  billedToPhone   String?       // optional
  billedToAddress String?
  voidedAt        DateTime?
  voidReason      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  items           InvoiceItem[]
  payments        Payment[]

  patient         Patient       @relation(fields: [patientId], references: [id])
}

model InvoiceItem {
  id          String              @id @default(cuid())
  invoiceId   String
  treatmentId String?             @unique // nullable — link to source treatment if applicable
  description String              // free text, e.g. "Root canal — tooth 14"
  amount      Float
  paidAmount  Float               @default(0)
  itemStatus  InvoiceItemStatus   @default(UNPAID)

  allocations PaymentAllocation[]

  invoice     Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  treatment   Treatment?          @relation(fields: [treatmentId], references: [id])
}

model Payment {
  id           String              @id @default(cuid())
  invoiceId    String
  amount       Float
  method       PaymentMethod
  note         String?
  status       PaymentStatus       @default(ACTIVE)
  recordedById String
  voidedById   String?
  voidedAt     DateTime?
  voidReason   String?
  createdAt    DateTime            @default(now())

  allocations  PaymentAllocation[]

  invoice      Invoice             @relation(fields: [invoiceId], references: [id])
  recordedBy   User                @relation(fields: [recordedById], references: [id], name: "recordedPayments")
  voidedBy     User?               @relation(fields: [voidedById], references: [id], name: "voidedPayments")
}

model PaymentAllocation {
  id            String      @id @default(cuid())
  paymentId     String
  invoiceItemId String
  amount        Float       // portion of the payment applied to this item
  createdAt     DateTime    @default(now())

  payment       Payment     @relation(fields: [paymentId], references: [id])
  invoiceItem   InvoiceItem @relation(fields: [invoiceItemId], references: [id])
}

// =============================================================================
// AUDIT
// =============================================================================

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?     // null for system-triggered events
  actorType  ActorType   @default(USER)
  targetId   String?
  targetType TargetType?
  action     AuditAction
  metadata   Json?
  ip         String?
  userAgent  String?
  trigger    TriggerType @default(USER_ACTION)
  createdAt  DateTime    @default(now())
}

// =============================================================================
// ENUMS — Identity & Auth
// =============================================================================

enum Role {
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_ACTIVATION       // account created, activation email sent, not yet activated
  PENDING_MFA_SETUP        // password set, MFA not yet configured
  PENDING_MFA_VERIFICATION // MFA secret generated, OTP not yet verified
  ACTIVE                   // fully activated, can log in
  SUSPENDED                // manually suspended by admin, cannot log in
}

// =============================================================================
// ENUMS — Clinical
// =============================================================================

enum AppointmentStatus {
  SCHEDULED // booked, upcoming
  COMPLETED // treatment recorded, auto-set
  CANCELLED // manually cancelled
}

enum VisitStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VisitProviderRole {
  PRIMARY
  ASSISTING
  HYGIENIST
  OTHER
}

enum TreatmentPlanStatus {
  PROPOSED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PlanItemStatus {
  PROPOSED
  COMPLETED
  CANCELLED
}

// =============================================================================
// ENUMS — Files
// =============================================================================

enum FileType {
  IMAGE
  PDF
  DICOM
}

enum FileStatus {
  PENDING   // upload URL issued, file not yet in R2
  CONFIRMED // client confirmed, server verified in R2
}

// =============================================================================
// ENUMS — Billing
// =============================================================================

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
  // STRIPE added later, once that's wired up
}

enum PaymentStatus {
  ACTIVE
  VOIDED
}

enum InvoiceStatus {
  DRAFT           // being prepared, not sent yet
  ISSUED          // sent to patient, awaiting payment
  PARTIALLY_PAID
  PAID
  OVERDUE         // derived/cron-updated based on dueAt
  CANCELLED
  VOIDED          // issued then voided — keeps audit trail, replaces a "delete"
}

enum InvoiceItemStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  WRITTEN_OFF // insurance adjustment / bad debt — separate from a real payment
}

// =============================================================================
// ENUMS — Audit
// =============================================================================

enum ActorType {
  USER
  SYSTEM
}

enum TargetType {
  USER
  PATIENT
  APPOINTMENT
  VISIT
  TREATMENT
  TREATMENT_PLAN
  TREATMENT_PLAN_ITEM
  INVOICE
  FILE
  SESSION
  ROLE
}

enum TriggerType {
  USER_ACTION  // initiated by a human via the UI
  ADMIN_ACTION // initiated by an admin via the admin panel
  SYSTEM       // cron job or automated process
  CASCADE      // side effect of another operation
}

enum AuditAction {
  // Auth
  LOGIN_SUCCESS
  LOGIN_MFA_PENDING
  LOGIN_FAILED
  LOGIN_MFA_FAILED
  LOGOUT
  LOGOUT_ALL
  SESSION_EXPIRED
  SESSION_REVOKED
  REMEMBER_TOKEN_ROTATED

  // Account lifecycle
  USER_CREATED
  USER_ACTIVATED
  USER_SUSPENDED
  USER_REACTIVATED
  USER_DELETED
  USER_EXPIRED_DELETED // cron cleanup

  // Account changes
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET
  EMAIL_CHANGED
  EMAIL_CHANGE_REQUESTED
  MFA_ENABLED
  MFA_DISABLED
  MFA_RESET // admin reset

  // Role management
  ROLE_ASSIGNED
  ROLE_REMOVED

  // Admin actions
  FORCE_LOGOUT
  ACTIVATION_RESENT
  ACCOUNT_UNLOCKED

  // Patient records
  PATIENT_CREATED
  PATIENT_UPDATED
  PATIENT_DELETED

  // Appointments
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_CANCELLED
  APPOINTMENT_DELETED

  // Visits
  VISIT_CREATED
  VISIT_UPDATED
  VISIT_CANCELLED
  VISIT_DELETED
  VISIT_PROVIDER_ADDED
  VISIT_PROVIDER_UPDATED
  VISIT_PROVIDER_REMOVED

  // Treatment plans
  TREATMENT_PLAN_CREATED
  TREATMENT_PLAN_UPDATED
  TREATMENT_PLAN_CANCELLED
  TREATMENT_PLAN_DELETED
  TREATMENT_PLAN_ITEM_ADDED
  TREATMENT_PLAN_ITEM_UPDATED
  TREATMENT_PLAN_ITEM_CONVERTED // proposal converted into a real Treatment
  TREATMENT_PLAN_ITEM_CANCELLED

  // Treatments
  TREATMENT_CREATED
  TREATMENT_UPDATED
  TREATMENT_DELETED

  // Invoices
  INVOICE_CREATED
  INVOICE_UPDATED
  INVOICE_ISSUED
  INVOICE_VOIDED
  INVOICE_DELETED
  INVOICE_ITEM_ADDED
  INVOICE_ITEM_UPDATED
  INVOICE_ITEM_REMOVED
  INVOICE_PAYMENT_RECORDED
  INVOICE_PAYMENT_VOIDED

  // Files
  FILE_UPLOADED
  FILE_DOWNLOADED
  FILE_DELETED
  FILE_PURGED

  // Audit
  AUDIT_CORRECTION // append-only correction reference
  AUDIT_PURGE      // legal deletion order
}
