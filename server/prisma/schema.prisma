// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String            @id @default(cuid())
  email             String        
  password          String?
  status            UserStatus        @default(PENDING_ACTIVATION)
  roles             UserRole[]
  phones            String[]          @default([])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?     

  name              UserName?
  addresses         Address[]
  appointments      Appointment[]
  uploadedFiles     File[]            @relation(name: "uploadedFiles")
  payments          Payment[] 
  userActivation    UserActivation?
  userMfa           UserMfa?
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  role       Role
  assignedBy String?  
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role]) 
}

model UserMfa {
  id                String    @id @default(cuid())
  enabled           Boolean   @default(false)
  mfaSecret         String?
  mfaUri            String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String    @unique
}

model UserActivation {
  id                String    @id @default(cuid())
  tokenId           String    @unique
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String    @unique
}

model UserName {
  id     String  @id @default(cuid())
  fName  String?
  mName  String?
  lName  String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String  @unique
}

model Address {
  id      String  @id @default(cuid())
  street  String?
  suburb  String?
  post    String?
  city    String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
}

model Patient {
  id           String        @id @default(cuid())
  firstName    String
  lastName     String
  dob          DateTime      // date of birth
  gender       String
  phone        String?
  email        String?
  address      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  appointments Appointment[]
  files        File[]
  invoices Invoice[]
}

model Appointment {
  id          String       @id @default(cuid())
  dentistId   String?
  patientId   String
  date        DateTime
  status      AppointmentStatus       @default(SCHEDULED) // SCHEDULED, COMPLETED, CANCELLED
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  dentist     User?        @relation(fields: [dentistId], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id])
  treatment   Treatment?   @relation 
}

model Treatment {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  procedure     String      // e.g. filling, extraction, cleaning
  toothNumber   Int?        // 1-32
  notes         String?
  amount        Float
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  invoiceItems  InvoiceItem[]
}

model AuditLog {
  id         String   @id @default(cuid())
  
  actorId    String?  // null for system-triggered events
  actorType  ActorType @default(USER)

  targetId   String?
  targetType TargetType?
  
  action     AuditAction
  
  metadata   Json?    
  ip         String?
  userAgent  String?
  trigger    TriggerType @default(USER_ACTION)
  
  createdAt  DateTime @default(now())
}

model File {
  id          String      @id @default(cuid())
  patientId   String
  uploadedBy  String
  fileName    String      // original name shown in UI
  storageKey  String      @unique  // R2 object key — never exposed to client
  mimeType    String
  fileType    FileType
  sizeBytes   Int
  status      FileStatus  @default(PENDING)
  createdAt   DateTime    @default(now())
  deletedAt   DateTime?

  patient     Patient     @relation(fields: [patientId], references: [id])
  uploader    User        @relation(fields: [uploadedBy], references: [id], name: "uploadedFiles")
}

model Invoice {
  id               String        @id @default(cuid())
  patientId        String
  patient          Patient       @relation(fields: [patientId], references: [id])
  invoiceNumber    String?       @unique   // e.g. INV-2026-0001, human-readable
  status           InvoiceStatus @default(DRAFT)
  subtotal         Float
  discount         Float
  tax              Float         @default(0)
  total            Float
  abn              String        @default("00000000000")
  notes            String?
  issuedAt         DateTime?
  dueAt            DateTime?
  paidAt           DateTime?
  billedToName     String?   // "ABC Insurance Pty Ltd"
  billedToEmail    String?   // "accounts@insurance.com"
  billedToPhone    String?   // optional
  billedToAddress  String? 
  voidedAt         DateTime?
  voidReason       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  items            InvoiceItem[]
  payments         Payment[] 
}

model InvoiceItem {
  id            String      @id @default(cuid())
  invoiceId     String
  invoice       Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  treatmentId   String?     // nullable — link to source treatment if applicable
  treatment     Treatment?  @relation(fields: [treatmentId], references: [id])
  description   String      // free text, e.g. "Root canal — tooth 14"
  amount        Float
}

enum InvoiceStatus {
  DRAFT       // being prepared, not sent yet
  ISSUED      // sent to patient, awaiting payment
  PARTIALLY_PAID
  PAID
  OVERDUE     // derived/cron-updated based on dueAt
  CANCELLED
  VOIDED        // issued then voided — keeps audit trail, replaces a "delete"
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
  // STRIPE added later, once that's wired up
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id])
  amount      Float
  method      PaymentMethod
  note        String?
  recordedById String
  recordedBy  User          @relation(fields: [recordedById], references: [id])
  createdAt   DateTime      @default(now())
}

enum FileType {
  IMAGE
  PDF
  DICOM
}

enum FileStatus {
  PENDING    // upload URL issued, file not yet in R2
  CONFIRMED  // client confirmed, server verified in R2
}

enum Role {
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum ActorType {
  USER       
  SYSTEM     
}

enum TargetType {
  USER
  PATIENT
  APPOINTMENT
  TREATMENT
  INVOICE
  FILE
  SESSION
  ROLE
}

enum TriggerType {
  USER_ACTION    // initiated by a human via the UI
  ADMIN_ACTION   // initiated by an admin via the admin panel
  SYSTEM         // cron job or automated process
  CASCADE        // side effect of another operation
}

enum AuditAction {
  // Auth
  LOGIN_SUCCESS
  LOGIN_MFA_PENDING
  LOGIN_FAILED
  LOGIN_MFA_FAILED
  LOGOUT
  LOGOUT_ALL
  SESSION_EXPIRED
  SESSION_REVOKED
  REMEMBER_TOKEN_ROTATED

  // Account lifecycle
  USER_CREATED
  USER_ACTIVATED
  USER_SUSPENDED
  USER_REACTIVATED
  USER_DELETED
  USER_EXPIRED_DELETED  // cron cleanup

  // Account changes
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET
  EMAIL_CHANGED
  EMAIL_CHANGE_REQUESTED
  MFA_ENABLED
  MFA_DISABLED
  MFA_RESET             // admin reset

  // Role management
  ROLE_ASSIGNED
  ROLE_REMOVED

  // Admin actions
  FORCE_LOGOUT
  ACTIVATION_RESENT
  ACCOUNT_UNLOCKED

  // Patient records
  PATIENT_CREATED
  PATIENT_UPDATED
  PATIENT_DELETED

  // Appointments
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_CANCELLED
  APPOINTMENT_DELETED

  // Treatments
  TREATMENT_CREATED
  TREATMENT_UPDATED
  TREATMENT_DELETED

  // Invoices
  INVOICE_CREATED
  INVOICE_UPDATED
  INVOICE_ISSUED
  INVOICE_VOIDED
  INVOICE_DELETED
  INVOICE_ITEM_ADDED
  INVOICE_ITEM_UPDATED
  INVOICE_ITEM_REMOVED
  INVOICE_PAYMENT_RECORDED
  INVOICE_PAYMENT_VOIDED

  // Files
  FILE_UPLOADED
  FILE_DOWNLOADED
  FILE_DELETED
  FILE_PURGED

  // Audit
  AUDIT_CORRECTION      // append-only correction reference
  AUDIT_PURGE           // legal deletion order
}

enum UserStatus {
  PENDING_ACTIVATION        // account created, activation email sent, not yet activated
  PENDING_MFA_SETUP         // password set, MFA not yet configured
  PENDING_MFA_VERIFICATION  // MFA secret generated, OTP not yet verified
  ACTIVE                    // fully activated, can log in
  SUSPENDED                 // manually suspended by admin, cannot log in
}

enum AppointmentStatus {
  SCHEDULED   // booked, upcoming
  COMPLETED   // treatment recorded, auto-set
  CANCELLED   // manually cancelled
}